{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/dsp/**/*",
    "src/analysis/**/*",
    "src/gestures/**/*",
    "src/preload/api.d.ts"
  ],
  "exclude": ["src/renderer/src/audio/worklets/**/*"]
}
